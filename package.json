{
  "name": "nc-web-frontend",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "mstart": "ng serve --host 0.0.0.0",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "test:ci": "ng test --watch=false --browsers=ChromeHeadless",
    "build-prod": "ng build --configuration production --base-href=/",
    "build-staging": "ng build --configuration production --base-href=/development/",
    "dev:ssr": "ng run nc-web-frontend:serve-ssr",
    "serve:ssr": "node dist/nc-web-frontend/server/main.js",
    "build:ssr": "ng build && ng run nc-web-frontend:server",
    "build-prod:ssr": "ng build --configuration production && ng run nc-web-frontend:server && npm run verify:styles",
    "build-staging:ssr": "ng build --configuration production --base-href=/development/ && ng run nc-web-frontend:server && npm run verify:styles",
    "prerender": "ng run nc-web-frontend:prerender",
    "verify:styles": "node scripts/verify-component-styles.js"
  },
  "private": true,
  "engines": {
    "node": "^24.0.0",
    "npm": ">=11.0.0"
  },
  "dependencies": {
    "@angular/animations": "^14.3.0",
    "@angular/common": "^14.3.0",
    "@angular/compiler": "^14.3.0",
    "@angular/core": "^14.3.0",
    "@angular/forms": "^14.3.0",
    "@angular/platform-browser": "^14.3.0",
    "@angular/platform-browser-dynamic": "^14.3.0",
    "@angular/platform-server": "^14.3.0",
    "@angular/router": "^14.3.0",
    "@angular/service-worker": "^14.3.0",
    "@nguniversal/express-engine": "^14.2.3",
    "@popperjs/core": "^2.11.5",
    "bootstrap": "^5.2.2",
    "bootstrap-icons": "^1.9.1",
    "express": "^4.15.2",
    "hamburgers": "^1.2.1",
    "jquery": "^3.6.0",
    "ngx-toastr": "^15.2.0",
    "popper.js": "^1.16.1",
    "rxjs": "~7.5.0",
    "service-worker": "^0.0.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.11.4"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^14.2.13",
    "@angular/cli": "~14.2.13",
    "@angular/compiler-cli": "^14.3.0",
    "@nguniversal/builders": "^14.2.3",
    "@types/express": "^4.17.0",
    "@types/jasmine": "~4.0.0",
    "@types/node": "^16.18.126",
    "jasmine-core": "~4.1.0",
    "karma": "~6.3.0",
    "karma-chrome-launcher": "~3.1.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.0.0",
    "karma-jasmine-html-reporter": "~1.7.0",
    "typescript": "~4.7.2"
  },
  "overrides": {
    "@babel/core": "^7.29.7",
    "@babel/runtime": "^7.29.7",
    "@npmcli/run-script": "^11.0.0",
    "@tootallnate/once": "^2.0.1",
    "ajv@8": "^8.20.0",
    "browser-sync": "^3.0.4",
    "cacache": "^21.0.1",
    "copy-webpack-plugin": "^14.0.0",
    "http-proxy-agent": "^5.0.0",
    "jsdom": "^20.0.0",
    "less": "^4.9.0",
    "make-fetch-happen": "^16.0.1",
    "minimatch@5": "^5.1.9",
    "node-gyp": "^13.0.1",
    "npm-registry-fetch": "^20.0.1",
    "pacote": "^22.0.0",
    "piscina": "^5.3.0",
    "postcss": "^8.5.26",
    "send": "^0.19.2",
    "serialize-javascript": "^7.1.0",
    "serve-static": "^1.16.3",
    "tar": "^7.5.22",
    "tmp": "^0.2.7",
    "uuid": "^11.1.1",
    "webpack": "~5.95.0",
    "webpack-dev-middleware": "^5.3.4"
  }
}
